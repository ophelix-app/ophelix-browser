{
  "name": "@ophelix/browser",
  "version": "0.1.0",
  "description": "Composant navigateur d'Ophelix : une page web lit une carte ou fait signer une facture sur le poste où elle s'affiche, sans extension.",
  "keywords": [
    "ophelix",
    "fse",
    "sesam-vitale",
    "carte-vitale",
    "cps",
    "assurance-maladie",
    "browser"
  ],
  "homepage": "https://docs.ophelix.fr/guides/pages-web",
  "bugs": {
    "url": "https://github.com/ophelix-app/ophelix-browser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ophelix-app/ophelix-browser.git"
  },
  "license": "MIT",
  "author": "Ophelix",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/ophelix-browser.global.js",
  "jsdelivr": "./dist/ophelix-browser.global.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.cjs && node scripts/smoke.mjs",
    "example": "bun example/server.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@ophelix/node": "^0.1.0",
    "@types/bun": "^1.4.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
